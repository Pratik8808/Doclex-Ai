generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      Role
  createdAt DateTime @default(now())

  documents Document[]
  reviews   Document[] @relation("LawyerReview")
}


model Document {
  id        String   @id @default(uuid())
  title     String
  content   String?
  source    DocumentSource
  status    DocumentStatus @default(PENDING)
  createdAt DateTime @default(now())

  userId    String
  user      User     @relation(fields: [userId], references: [id])

  lawyerId  String?
  lawyer    User?    @relation("LawyerReview", fields: [lawyerId], references: [id])

  aiResult  AIResult?
}

model AIResult {
  id         String   @id @default(uuid())
  decision   String
  score      Int?
  createdAt  DateTime @default(now())

  documentId String   @unique
  document   Document @relation(fields: [documentId], references: [id])
}

enum Role {
  USER
  LAWYER
}


enum DocumentSource {
  EDITOR
  UPLOAD
  DRIVE
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
  REVIEW
}
