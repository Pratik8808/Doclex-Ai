generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  password     String
  firstName    String
  lastName     String
  role         Role
  refreshToken String?
  createdAt    DateTime   @default(now())

  // User owns documents
  ownedDocuments   Document[] @relation("OwnerDocuments")

  // Lawyer assigned documents
  assignedDocuments Document[] @relation("AssignedLawyer")
}

model Document {
  id        String         @id @default(uuid())
  title     String
  source    DocumentSource
  status    DocumentStatus @default(DRAFT)
  createdAt DateTime       @default(now())

  // Original text (if editor)
  content   String?

  // Uploaded file
  filePath  String?

  // Document Owner
  userId String
  user   User @relation("OwnerDocuments", fields: [userId], references: [id])

  // 🔒 Single Assigned Lawyer
  lawyerId String?
  lawyer   User? @relation("AssignedLawyer", fields: [lawyerId], references: [id])

  // AI Review
  aiResult AIResult?

  // 🔹 Lawyer Review Section (ONLY ONE REVIEW)
  lawyerDecision   DocumentStatus?
  lawyerFeedback   String?
  lawyerSuggestion String?
  revisedContent   String?
  reviewedAt       DateTime?
}

model AIResult {
  id         String   @id @default(uuid())
  decision   String
  score      Int?
  feedback   String?
  createdAt  DateTime @default(now())

  documentId String   @unique
  document   Document @relation(fields: [documentId], references: [id])
}

enum Role {
  USER
  LAWYER
}

enum DocumentSource {
  EDITOR
  UPLOAD
  DRIVE
}

enum DocumentStatus {
  DRAFT
  AI_REVIEWED
  REVIEW_REQUESTED
  APPROVED
  REJECTED
}