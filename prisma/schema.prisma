generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  password     String
  firstName    String
  lastName     String
  role         Role
  refreshToken String?
  createdAt    DateTime   @default(now())

  // User owns documents
  ownedDocuments   Document[] @relation("OwnerDocuments")

  // Lawyer assigned documents
  assignedDocuments Document[] @relation("AssignedLawyer")
}


 model Document {
  id        String         @id @default(uuid())
  title     String
  source    DocumentSource
  status    DocumentStatus @default(DRAFT)
  createdAt DateTime       @default(now())

 
  content        String?   
  plainText      String?   

  // File upload
  filePath       String?
  fileType       String?   // pdf | docx | image

  // Ownership
  userId String
  user   User @relation("OwnerDocuments", fields: [userId], references: [id])

  lawyerId String?
  lawyer   User? @relation("AssignedLawyer", fields: [lawyerId], references: [id])

  // AI
  aiResult AIResult?

  // Lawyer review
  lawyerDecision   DocumentStatus?
  lawyerFeedback   String?
  lawyerSuggestion String?
  revisedContent   String?  
  reviewedAt       DateTime?
}


model AIResult {
  id            String   @id @default(uuid())

  
  score         Int?
  riskLevel     String?
  missingFields String[] 
  summary       String?


  decision      String?   
  feedback      String?

  createdAt     DateTime @default(now())


  documentId    String   @unique
  document      Document @relation(fields: [documentId], references: [id])
}

enum Role {
  USER
  LAWYER
}

enum DocumentSource {
  EDITOR
  UPLOAD
  DRIVE
  MANUAL
}

enum DocumentStatus {
  DRAFT
  AI_PROCESSING   
  AI_REVIEWED
  REVIEW_REQUESTED
  APPROVED
  REJECTED
}