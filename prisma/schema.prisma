generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  password     String
  firstName    String
  lastName     String
  role         Role
  refreshToken String?
  createdAt    DateTime   @default(now())

  documents Document[] @relation("OwnerDocuments")
  reviews   Document[] @relation("LawyerDocuments")
}

model Document {
  id        String         @id @default(uuid())
  title     String
  source    DocumentSource
  status    DocumentStatus @default(DRAFT)
  createdAt DateTime       @default(now())
  userId    String
  content   String?
  lawyerId  String?
  filePath  String?
  aiResult  AIResult?
  lawyer    User?          @relation("LawyerDocuments", fields: [lawyerId], references: [id])
  user      User           @relation("OwnerDocuments", fields: [userId], references: [id])
}

model AIResult {
  id         String   @id @default(uuid())
  decision   String
  score      Int?
  createdAt  DateTime @default(now())
  documentId String   @unique
  feedback   String?
  document   Document @relation(fields: [documentId], references: [id])
}

enum Role {
  USER
  LAWYER
}

enum DocumentSource {
  EDITOR
  UPLOAD
  DRIVE
}

enum DocumentStatus {
  DRAFT
  AI_REVIEWED
  REVIEW_REQUESTED
  APPROVED
  REJECTED
}
