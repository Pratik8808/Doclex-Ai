generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      Role
  createdAt DateTime @default(now())

  // Documents created by this user
  documents Document[] @relation("OwnerDocuments")

  // Documents this lawyer reviews
  reviews   Document[] @relation("LawyerDocuments")
}



model Document {
  id        String   @id @default(uuid())
  title     String
  content   String?
  source    DocumentSource
  status    DocumentStatus @default(DRAFT)
  createdAt DateTime @default(now())
  filePath  String? 

  // Creator (USER or LAWYER)
  userId    String
  user      User     @relation("OwnerDocuments", fields: [userId], references: [id])

  // Assigned lawyer (optional)
  lawyerId  String?
  lawyer    User?    @relation("LawyerDocuments", fields: [lawyerId], references: [id])

  aiResult  AIResult?
}


model AIResult {
  id         String   @id @default(uuid())
  decision   String
  score      Int?
  feedback   String?
  createdAt  DateTime @default(now())

  documentId String   @unique
  document   Document @relation(fields: [documentId], references: [id])
}

enum Role {
  USER
  LAWYER
}


enum DocumentSource {
  EDITOR
  UPLOAD
  DRIVE
}

enum DocumentStatus {
  DRAFT
  AI_REVIEWED
  REVIEW_REQUESTED
  APPROVED
  REJECTED
}

